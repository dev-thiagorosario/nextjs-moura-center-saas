// Configurações públicas da loja; segredos de integrações ficam no ambiente.
model StoreSettings {
  id                    String   @id @default("default")
  name                  String
  supportEmail          String?
  supportPhone          String?
  whatsapp              String?
  instagramUrl          String?
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
